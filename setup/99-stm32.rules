# STM32 / USB-to-UART symlink rules -> /dev/ttySTM32 và /dev/stm32
# 1. Silicon Labs CP2102 / CP210x (10c4:ea60)
KERNEL=="ttyUSB*", SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE:="0666", SYMLINK+="ttySTM32 stm32"

# 2. WCH CH340 / CH341 (1a86:7523, 1a86:5523)
KERNEL=="ttyUSB*", SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", MODE:="0666", SYMLINK+="ttySTM32 stm32"
KERNEL=="ttyUSB*", SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="5523", MODE:="0666", SYMLINK+="ttySTM32 stm32"

# 3. FTDI FT232R / FT232H (0403:6001, 0403:6014, 0403:6010)
KERNEL=="ttyUSB*", SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", MODE:="0666", SYMLINK+="ttySTM32 stm32"
KERNEL=="ttyUSB*", SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6014", MODE:="0666", SYMLINK+="ttySTM32 stm32"

# 4. Prolific PL2303 (067b:2303)
KERNEL=="ttyUSB*", SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="2303", MODE:="0666", SYMLINK+="ttySTM32 stm32"

# 5. STM32 Virtual COM Port / Native CDC (0483:5740) -> ttyACM*
KERNEL=="ttyACM*", SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", MODE:="0666", SYMLINK+="ttySTM32 stm32"
